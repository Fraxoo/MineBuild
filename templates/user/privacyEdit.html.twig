{% extends 'base.html.twig' %}

{% block title %}Edit User{% endblock %}

{% block body %}
<div class="flex flex-col mx-auto w-full max-w-4xl md:px-4  gap-4 ">
    <twig:UserEditNav :user="user" />
    <div class="user-edit-container border! border-(--red-border)!">
        <div class="flex flex-col gap-2">
            <div class="flex gap-2 text-red-500 items-center">
                <i class="ti ti-alert-triangle"></i>
                <h1 class="font-bold ">Zone de danger</h1>
            </div>
            <p class="text-(--secondary-color)">Action irréversible faite attention</p>
        </div>
        <div class="flex p-4 bg-(--red-background) flex-wrap gap-2 rounded-lg border border-(--red-border)  justify-between items-center">
            <div class="flex  flex-col gap-2">
                <h3 class="text-(--title-color) font-bold">Supprimer mon compte</h3>
                <p class="text-(--secondary-color)">Supprimer définitivement votre compte et toutes les données associées.</p>
            </div>
            <div {{ stimulus_controller('modal-form') }}>
                <button data-action="click->modal-form#openModal" class="red-button" type="button">
                    <i class="ti ti-trash"></i>
                    Supprimer
                </button>
                <twig:UserDeleteModal :id="user.id" type="user" />
            </div>
        </div>
    </div>
</div>




{# {{ include('user/_delete_form.html.twig') }} #}
{% endblock %}
