{% extends 'base.html.twig' %}

{% block title %}User
{% endblock %}

{% block body %}
<div class="flex flex-col gap-4">
	<twig:GoBack />
	<div class="flex gap-4 flex-wrap items-center justify-between w-full bg-(--container-color) p-8 rounded">
		<div class="flex flex-wrap gap-4 items-center">
			<img class="w-28 h-28 rounded-full border-4 border-(--border-color-secondary) object-cover"
				data-avatar-preview-target="image"
				src="{{ user.avatarUrl ? asset('uploads/avatars/' ~ user.avatarUrl) : asset('images/default-avatar.jpg') }}"
				alt="Avatar de {{ user.username }}">
			<div class="flex flex-wrap flex-col gap-2 justify-between">
				<div class="flex gap-2">
					<h2 class="font-bold text-2xl text-(--title-color)">{{user.username}}</h2>
					{% if app.user and app.user.id == user.id %}
					<a class="flex text-(--title-color) font-bold gap-2 px-2 py-1 text-xs rounded items-center border border-(--border-color)"
						href="{{ path('app_user_edit', {id: user.id}) }}">
						<i class="ti ti-edit"></i>
						<p>Modifier mon profil</p>
					</a>

					{% endif %}
				</div>
				<p class="text-(--secondary-color)">{{ user.bio ? user.bio : 'Aucune bio pour le moment' }}</p>
				<div class="flex items-center gap-4 text-(--secondary-color)">
					<div class="flex items-center gap-2">
						<i class="ti ti-calendar-event"></i>
						<p>Inscrit depuis le
							{{ user.createdAt|date('d/m/Y') }}</p>
					</div>
					{% if app.user and app.user.id !== user.id %}
					<a href="{{ path('app_report_new_user' , { id : user.id})}}"
						class="container-color-button px-2! py-1! ">
						<i class="ti ti-flag"></i>
						<p>Signaler</p>
					</a>
					{% endif %}
				</div>
			</div>
		</div>
		<div class="flex gap-4 items-center">
			<div class="flex flex-col gap-2 items-center">
				<p class="text-(--title-color) font-bold">{{ user.followerRelations|length }}</p>
				<p class="text-(--secondary-color)">Followers</p>
			</div>
			<div class="flex flex-col gap-2 items-center">
				<p class="text-(--title-color) font-bold">{{ user.followingRelations|length }}</p>
				<p class="text-(--secondary-color)">Following</p>
			</div>
		</div>
	</div>
	<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
		<div class="user-box">
			<i class=" bg-[#28372d]  text-[#4ae583] ti ti-blocks"></i>
			<div>
				<p class="text-(--title-color) font-bold">{{ user.builds|length }}</p>
				<p class="text-(--secondary-color)">Total builds</p>
			</div>
		</div>
		<div class="user-box">
			<i class="ti ti-users  bg-[#242d3a]  text-[#2a85fd]"></i>
			<div>
				<p class="text-(--title-color) font-bold">{{ totalViews }}</p>
				<p class="text-(--secondary-color)">Total vues</p>
			</div>
		</div>
		<div class="user-box">
			<i class="bg-[#3a2426]  text-[#ff2b36] ti ti-heart"></i>
			<div>
				<p class="text-(--title-color) font-bold">{{ totalLikes }}</p>
				<p class="text-(--secondary-color)">Total J'aimes</p>
			</div>
		</div>
		<div class="user-box">
			<i class="ti ti-star  bg-[#203428]  text-[#00c84e]"></i>
			<div>
				<p class="text-(--title-color) font-bold">{{ totalSaves }}</p>
				<p class="text-(--secondary-color)">Total Sauvegarde</p>
			</div>
		</div>
	</div>
	<div class="user-filter-container">
		<a href="{{ path('app_user_show', {id: user.id}) }}"
			class="user-filter {{ app.request.attributes.get('_route') === 'app_user_show' ? 'user-selected-filter' : '' }}">
			<i class="ti ti-blocks"></i>
			{# <p>Builds ({{ user.builds|length }})</p> #}
			<p>Builds</p>
		</a>
		<a href="{{ path('app_user_favorites', {id: user.id}) }}"
			class="user-filter {{ app.request.attributes.get('_route') === 'app_user_favorites' ? 'user-selected-filter' : '' }}">
			<i class="ti ti-heart"></i>
			{# <p>Favoris ({{ user.buildSaves|length }})</p> #}
			<p>Favoris</p>

		</a>
		<a href="{{ path('app_user_followers', {id: user.id}) }}"
			class="user-filter {{ app.request.attributes.get('_route') === 'app_user_followers' ? 'user-selected-filter' : '' }}">
			<i class="ti ti-users"></i>
			{# <p>Followers ({{ user.followerRelations|length }})</p> #}
			<p>Followers</p>

		</a>
		<a href="{{ path('app_user_following', {id: user.id}) }}"
			class="user-filter {{ app.request.attributes.get('_route') === 'app_user_following' ? 'user-selected-filter' : '' }}">
			<i class="ti ti-user-plus"></i>
			{# <p>Following ({{ user.followingRelations|length }})</p> #}
			<p>Following</p>
		</a>
	</div>
	<div>

		{% if items|length > 0 %}
		{% if isFollow %}
		<twig:PaginationComponent :items="items" :isFollow="true" :followType="followType" :totalPages="totalPages"
			:totalItems="totalItems" :user="user" :currentPage="currentPage" />
		{% else %}
		<twig:PaginationComponent :items="items" :isFollow="false" :totalPages="totalPages" :totalItems="totalItems"
			:user="user" :currentPage="currentPage" />
		{% endif %}

		{% else %}
		<p class="text-(--secondary-color)">Aucun contenu à afficher.</p>
		{% endif %}
	</div>
</div>


{% endblock %}