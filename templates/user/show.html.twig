{% extends 'base.html.twig' %}

{% block title %}User
{% endblock %}

{% block body %}
<div class="flex flex-col gap-4">
	<h1 class="sr-only">Profil de {{ user.username }}</h1>
	<twig:GoBack />
	<twig:UserInfo :user="user" :isFollowedByUser="isFollowedByUser" />
	<section class="md grid-cols-1 hidden sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4" aria-labelledby="profile-stats-title">
		<h2 id="profile-stats-title" class="sr-only">Statistiques du profil</h2>
		<div class="user-box">
			<i class=" bg-[#28372d]  text-[#4ae583] ti ti-blocks"></i>
			<dl class="flex flex-col">
				<dt class="text-(--secondary-color)">Total builds</dt>
				<dd class="text-(--title-color) font-bold order-first">{{ user.builds|length }}</dd>
			</dl>
		</div>
		<div class="user-box">
			<i class="ti ti-users  bg-[#242d3a]  text-[#2a85fd]"></i>
			<dl class="flex flex-col">
				<dt class="text-(--secondary-color)">Total vues</dt>
				<dd class="text-(--title-color) font-bold order-first">{{ totalViews }}</dd>
			</dl>
		</div>
		<div class="user-box">
			<i class="bg-[#3a2426]  text-[#ff2b36] ti ti-heart"></i>
			<dl class="flex flex-col">
				<dt class="text-(--secondary-color)">Total J’aime</dt>
				<dd class="text-(--title-color) font-bold order-first">{{ totalLikes }}</dd>
			</dl>
		</div>
		<div class="user-box">
			<i class="ti ti-star  bg-[#203428]  text-[#00c84e]"></i>
			<dl class="flex flex-col">
				<dt class="text-(--secondary-color)">Total sauvegardes</dt>
				<dd class="text-(--title-color) font-bold order-first">{{ totalSaves }}</dd>
			</dl>
		</div>
	</section>
	<nav class="user-filter-container" aria-label="Contenu du profil">
		<a href="{{ path('app_user_show', {id: user.id}) }}"
			class="user-filter {{ app.request.attributes.get('_route') === 'app_user_show' ? 'user-selected-filter' : '' }}">
			<i class="ti ti-blocks"></i>
			{# <p>Builds ({{ user.builds|length }})</p> #}
			<p>Builds</p>
		</a>
		<a href="{{ path('app_user_favorites', {id: user.id}) }}"
			class="user-filter {{ app.request.attributes.get('_route') === 'app_user_favorites' ? 'user-selected-filter' : '' }}">
			<i class="ti ti-heart"></i>
			{# <p>Favoris ({{ user.buildSaves|length }})</p> #}
			<p>Favoris</p>

		</a>
		<a href="{{ path('app_user_followers', {id: user.id}) }}"
			class="user-filter {{ app.request.attributes.get('_route') === 'app_user_followers' ? 'user-selected-filter' : '' }}">
			<i class="ti ti-users"></i>
			{# <p>Followers ({{ user.followerRelations|length }})</p> #}
			<p>Followers</p>

		</a>
		<a href="{{ path('app_user_following', {id: user.id}) }}"
			class="user-filter {{ app.request.attributes.get('_route') === 'app_user_following' ? 'user-selected-filter' : '' }}">
			<i class="ti ti-user-plus"></i>
			{# <p>Following ({{ user.followingRelations|length }})</p> #}
			<p>Suivi(e)s</p>
		</a>
	</nav>
	<section class="flex flex-col md:grid md:grid-cols-4 gap-4" aria-label="Contenu du profil">
		{% if items|length > 0 %}

		{% if isFollow %}

		{% for item in items %}

		{% set followUser = followType == 'followers' ? item.follower : item.following %}
		<twig:UserCard :item="item" :followType="followType" />
		{% endfor %}

		{% else %}
		{% for item in items %}
		<twig:BuildCard :build="item" />
		{% endfor %}

		{% endif %}

		{% else %}

		<p class="text-(--secondary-color)">Aucun contenu à afficher.</p>

		{% endif %}
	</section>
	<twig:PaginationComponent :totalPages="totalPages" :totalItems="totalItems" :currentPage="currentPage" />
</div>


{% endblock %}
