{% extends 'base.html.twig' %}

{% block title %}User{% endblock %}

{% block body %}
<twig:GoBack />
<div class="flex gap-4 justify-between w-full bg-(--container-color) p-4 rounded">
    <div class="flex gap-4 items-center">
        <p>Avatar</p>
        <div class="flex flex-col justify-between">
            <div class="flex gap-2">
                <h2 class="font-bold text-2xl text-(--title-color)">{{user.username}}</h2>
                {% if app.user and app.user.id == user.id %}
                <a class="flex text-(--title-color) font-bold gap-2 px-2 py-1 text-xs rounded items-center border border-(--border-color)"
                    href="{{ path('app_user_edit', {id: user.id}) }}">
                    <i class="fa-regular fa-pen-to-square"></i>
                    <p>Modifier mon profil</p>
                </a>
                {% endif %}
            </div>
            <p class="text-(--secondary-color)">{{ user.bio ? user.bio : 'Aucune bio pour le moment' }}</p>
            <div class="text-(--secondary-color)">
                <div class="flex items-center gap-2">
                    <i class="fa-regular fa-calendar"></i>
                    <p>Inscrit depuis le {{ user.createdAt|date('d/m/Y') }}</p>
                </div>
                <div class="flex items-center gap-2">
                    <i class="fa-solid fa-table-cells"></i>
                    <p>{{ user.builds|length }} {{ user.builds|length > 1 ? 'builds' : 'build' }}</p>
                </div>
            </div>
        </div>
    </div>
    <div>
        <div></div>
        <div></div>
    </div>
</div>

{% endblock %}