{% extends 'base.html.twig' %}

{% block title %}Edit User{% endblock %}

{% block body %}
<div class="flex flex-col mx-auto w-full max-w-4xl md:px-4  gap-4 ">
    <twig:UserEditNav :user="user" />
    {{ form_start(form , {
    'attr' : {'class' : 'user-edit-container'}}
    ) }}
	<h2 class="text-(--title-color) font-bold">Changer le mot de passe</h2>
    <p class="text-(--secondary-color)">Modifier le mot de passe pour garder votre compte sécurisé</p>
    <div>
		{{ form_label(form.currentPassword, 'Mot de passe actuel', {'label_attr': {'class': 'input-title'}}) }}
        {{ form_widget(form.currentPassword , {
        'attr' : {'class' : 'input input-input'}}
        ) }}
        <div class="error-message">
            {{ form_errors(form.currentPassword , {
            'attr' : {'class' : 'error-message'}}
            ) }}
            </div>
    </div>
    <div>
		{{ form_label(form.plainPassword.first, 'Nouveau mot de passe', {'label_attr': {'class': 'input-title'}}) }}
        {{ form_widget(form.plainPassword.first , {
        'attr' : {'class' : 'input input-input'}}
        ) }}
        <div class="error-message">
            {{ form_errors(form.plainPassword.first , {
            'attr' : {'class' : 'error-message'}}
            ) }}
        </div>
    </div>
    <div>
		{{ form_label(form.plainPassword.second, 'Confirmer le nouveau mot de passe', {'label_attr': {'class': 'input-title'}}) }}
        {{ form_widget(form.plainPassword.second , {
        'attr' : {'class' : 'input input-input'}}
        ) }}
        {{ form_errors(form.plainPassword.second , {
        'attr' : {'class' : 'error-message'}}
        ) }}
    </div>
    <div class="error-message">
        {{ form_errors(form)}}
    </div>
    <div class="flex gap-4 flex-wrap items-center justify-end">
        <a class="container-color-button" href="">Annuler</a>
        <button class="primary-button" type="submit">Sauvegarder</button>
    </div>
    {{ form_end(form) }}

</div>




{# {{ include('user/_delete_form.html.twig') }} #}
{% endblock %}
