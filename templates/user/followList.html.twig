{% extends 'base.html.twig' %}

{% block title %}Follow List
{% endblock %}

{% block body %}
<div class="flex flex-col gap-4">
    <twig:GoBack />
    {% if type == 'followers' %}
    <h1 class="title">Abonnés de
        {{ user.username }}</h1>
    {% else %}
    <h1 class="title">Abonnements de
        {{ user.username }}</h1>
    {% endif %}


    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
        {% for relation in follows %}
        {% set followUser = type == 'followers' ? relation.follower : relation.following %}
        <div class="user-box">
            <a href="{{ path('app_user_show', {id: followUser.id}) }}" class="flex items-center gap-4">
                <img class="w-12 h-12 rounded-full object-cover"
                    src="{{ followUser.avatarUrl ? asset('uploads/avatars/' ~ followUser.avatarUrl) : asset('images/default-avatar.jpg') }}"
                    alt="Avatar de {{ followUser.username }}">
                <p class="text-(--title-color) hover:underline font-bold">{{ followUser.username }}</p>
            </a>
        </div>
        {% else %}
        <p class="text-(--secondary-color)">Aucun résultat pour le moment.</p>
        {% endfor %}
    </div>
</div>

{% endblock %}
