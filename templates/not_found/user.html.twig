{% extends 'base.html.twig' %}

{% block title %}Page introuvable{% endblock %}

{% block body %}
<section class="min-h-full w-full flex items-center justify-center p-4 md:p-8 bg-[var(--background-color)]">
    <div class="w-full max-w-xl rounded-2xl border border-[var(--border-color-secondary)] bg-[var(--container-color)] p-6 md:p-8 shadow-2xl shadow-black/30 flex flex-col items-center text-center gap-6">

        <div class="flex h-16 w-16 items-center justify-center rounded-2xl border border-[var(--border-color-secondary)] bg-[var(--container-color-secondary)] text-[var(--primary-color)] text-3xl">
            <i class="fa-solid fa-cube"></i>
        </div>

        <div class="flex flex-col gap-2">
            <p class="text-7xl md:text-8xl font-black leading-none tracking-tighter text-[var(--primary-color)]">
                404
            </p>

            <h1 class="text-2xl md:text-3xl font-bold text-[var(--title-color)]">
                Utilisateur introuvable
            </h1>

            <p class="max-w-md text-[var(--secondary-color)] leading-relaxed">
                La page que vous recherchez n’existe pas ou a peut-être été déplacée.
            </p>
        </div>

        <div class="flex w-full flex-col sm:flex-row gap-3 justify-center">
            <a
                href="{{ path('app_home') }}"
                class="inline-flex items-center justify-center rounded-lg bg-[var(--primary-color)] px-5 py-3 font-bold text-[var(--fourth-color)] transition hover:bg-green-500 active:scale-95"
            >
                Retour à l’accueil
            </a>

			<button
				type="button"
				onclick="history.back()"
                class="inline-flex items-center justify-center rounded-lg border border-[var(--border-color-secondary)] bg-[var(--container-color-secondary)] px-5 py-3 font-bold text-[var(--title-color)] transition hover:border-[var(--primary-color)] hover:bg-[var(--container-color-third)] active:scale-95"
            >
                Revenir en arrière
			</button>
        </div>
    </div>
</section>
{% endblock %}
