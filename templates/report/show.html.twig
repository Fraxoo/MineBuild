{% extends 'base.html.twig' %}

{% block title %}Report{% endblock %}

{% block body %}
    <h1>Report</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ report.id }}</td>
            </tr>
            <tr>
                <th>Target_type</th>
                <td>{{ report.targetType.value }}</td>
            </tr>
            <tr>
                <th>Reason_code</th>
                <td>{{ report.reasonCode.value }}</td>
            </tr>
            <tr>
                <th>Message</th>
                <td>{{ report.message }}</td>
            </tr>
            <tr>
                <th>Status</th>
                <td>{{ report.status.value }}</td>
            </tr>
            <tr>
                <th>Handled_at</th>
                <td>{{ report.handledAt ? report.handledAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Created_at</th>
                <td>{{ report.createdAt ? report.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Updated_at</th>
                <td>{{ report.updatedAt ? report.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_report_index') }}">back to list</a>

    <a href="{{ path('app_report_edit', {'id': report.id}) }}">edit</a>

    {{ include('report/_delete_form.html.twig') }}
{% endblock %}
