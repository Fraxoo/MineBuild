{% extends 'base.html.twig' %}

{% block title %}Report index
{% endblock %}

{% block body %}
<div class="flex flex-col items-center gap-4">
    <div class="flex flex-col w-full max-w-[56rem] m-auto gap-4">
        <twig:GoBack />
        <h3 class="text-4xl text-(--title-color) font-bold">Panneau de Modération</h3>
        <p class="text-(--secondary-color) text-xl">Traiter les signalements, masquer les contenus non conformes et
            consulter l’historique des actions.</p>
        <twig:DashboardNav />
        {% if app.request.attributes.get('_route') === 'app_report_index' %}
        <twig:ReportsComponent :reports="reports" />

        {% elseif app.request.attributes.get('_route') === 'app_report_history' %}
        <twig:ReportHistoryComponent />

        {% elseif app.request.attributes.get('_route') === 'app_report_users' %}
        <twig:ReportUsersComponent />
        {% endif %}
        <twig:PaginationComponent :totalitems="totalItems" :currentpage="currentPage" :totalpages="totalPages" />

    </div>


</div>
{% endblock %}