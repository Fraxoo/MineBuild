{% extends 'base.html.twig' %}

{% block title %}Build
{% endblock %}

{% block body %}
<div class="flex flex-col  gap-4">
    <twig:GoBack />
    <div class="flex gap-4 flex-wrap flex-3">
        <div class="flex overflow-auto flex-col gap-4 md:flex-2">
            <div class="relative w-full h-full  overflow-hidden rounded-xl" data-carousel>
                <div class="flex  transition-transform duration-300 ease-in-out" data-carousel-track>

                    {% for image in build.images %}
                    <div class="min-w-full bg-black flex  items-center">
                        <img src="{{ asset('uploads/build_images/' ~ image.url) }}" alt="{{ build.title }}"
                            class="w-full md:h-[600px] object-contain">
                    </div>
                    {% endfor %}
                </div>

                {% if build.images|length > 1 %}
                <button type="button"
                    class="absolute left-3 top-1/2 -translate-y-1/2 bg-black/50 text-white px-3 py-2 rounded-full"
                    data-carousel-prev>
                    <i class="fa-solid fa-angle-left"></i>
                </button>

                <button type="button"
                    class="absolute right-3 top-1/2 -translate-y-1/2 bg-black/50 text-white px-3 py-2 rounded-full"
                    data-carousel-next>
                    <i class="fa-solid fa-angle-right"></i>
                </button>
                {% endif %}
            </div>
            <div class="flex w-full flex-col">
                <h3 class="text-3xl font-bold uppercase text-(--title-color)">{{ build.title }}</h3>
                <p class="text-(--secondary-color) break-all text-xl">{{ build.description }}</p>
            </div>

            <twig:BuildActions :build="build" :isLikedByUser="isLikedByUser" :isSavedByUser="isSavedByUser" />


            <div data-controller="mobile-filters" class="container p-0! md:p-8!">
                <div class="flex items-center md:hidden justify-between gap-4 p-4">
                    <div class="text-(--title-color) flex items-center gap-2 font-bold text-xl">
                        <i class="ti ti-message-circle"></i>
                        <h3 class="break-everywhere">Commentaires ({{ build.comments|length }})</h3>
                    </div>
                    <button type="button" class="md:hidden inline-flex leading-none h-fit text-white text-4xl"
                        data-mobile-filters-target="button" data-action="mobile-filters#toggle"
                        aria-expanded="false" aria-controls="mobile-build-comments-{{ build.id }}">
                        <i class="ti ti-chevron-up"></i>
                    </button>
                </div>

                <div id="mobile-build-comments-{{ build.id }}" class="hidden md:flex flex-col gap-4 p-4 md:p-0"
                    data-mobile-filters-target="panel">
                    <div class="text-(--title-color) hidden md:flex items-center gap-2 font-bold text-xl">
                        <i class="ti ti-message-circle"></i>
                        <h3 class="break-everywhere">Commentaires ({{ build.comments|length }})</h3>
                    </div>
                    {% if app.user %}
                    <div class="flex  gap-4 w-full">
                        <img class="w-12 h-12 rounded-full"
                            src="{{ app.user.avatarUrl ? asset('uploads/avatars/' ~ app.user.avatarUrl) : asset('images/default-avatar.jpg') }}"
                            alt="Avatar de {{ app.user.username }}">
                        {{ form_start(form, {
                        attr: {
                        class: 'w-full flex flex-col gap-2',
                        }
                        }) }}

                        {{ form_widget(form.content, {
                        attr: {
                        class: 'w-full border border-(--border-color) bg-(--container-color-secondary) px-4 py-2 rounded
                        text-(--title-color) focus:outline-none focus:ring-2 focus:ring-(--primary-color)
                        focus:ring-opacity-50',
                        }
                        }) }}

                        <div class="error-message flex flex-col gap-2">
                            {{ form_errors(form.content) }}
                            {{ form_errors(form) }}
                        </div>

                        <button type="submit" class="primary-button w-fit">
                            Commenter
                        </button>

                        {{ form_end(form) }}
                    </div>
                    {% else %}
                    <p class="text-(--secondary-color)"><a class="hover:underline font-semibold text-(--primary-color)"
                            href="{{ path('app_login') }}">Connectez-vous</a> pour laisser un commentaire.</p>
                    {% endif %}

                    {% for comment in build.comments %}
                    <twig:Comments :comment="comment" :build="build" />
                    {% endfor %}
                </div>
            </div>

        </div>






        <div class="flex flex-col gap-4 flex-1">

            <twig:BuildUserAction :build="build" :isFollowedByUser="isFollowedByUser"  />

            <div class="container">
                <h3 class="title">Détails</h3>
                <div class="build-info-gap">
                    <div class="build-info-gap-title">
                        <i class="ti ti-device-gamepad-2"></i>
                        <p>Version</p>
                    </div>
                    <div class="flex flex-wrap gap-2">
                        {% for buildVersion in build.buildVersions %}
                            <p class="bg-(--container-color-secondary) px-2 py-1 text-(--title-color) rounded text-[0.875rem]">
                                {{ buildVersion.version.number }}
                            </p>
                        {% else %}
                            <p class="bg-(--container-color-secondary) px-2 py-1 text-(--title-color) rounded text-[0.875rem]">
                                Non renseignée
                            </p>
                        {% endfor %}
                    </div>
                </div>
                <div class="build-info-gap">
                    <div class="build-info-gap-title">
                        <i class="ti ti-bolt"></i>
                        <p>Difficulté</p>
                    </div>
                    <p
                        class=" font-bold {{ build.difficulty === 'easy' ? 'bg-green-600/10 text-green-200' : build.difficulty === 'medium' ? 'bg-blue-600/10 text-blue-600' : build.difficulty === 'hard' ? 'bg-orange-900/10 text-orange-400' : 'bg-red-600/10 text-red-200' }} px-2 py-1  rounded text-[0.875rem]">
                        {{ build.difficulty }}</p>
                </div>
                <div class="build-info-gap">
                    <div class="build-info-gap-title">
                        <i class="ti ti-ruler-2"></i>
                        <p>Taille</p>
                    </div>
                    <p class="bg-(--container-color-secondary) px-2 py-1 text-(--title-color) rounded text-[0.875rem]">
                        L : {{build.dimensionsX ? build.dimensionsX : "-"}} H : {{build.dimensionsY ? build.dimensionsY : "-"}} L : {{build.dimensionsZ ? build.dimensionsZ : "-"}}</p>
                </div>
                <div class="build-info-gap">
                    <div class="build-info-gap-title">
                        <i class="ti ti-calendar-event"></i>
                        <p>Publié le </p>
                    </div>
                    <p class=" px-2 py-1 text-(--title-color) rounded text-[0.875rem]">{{ build.createdAt|date('d/m/Y')
                        }}</p>
                </div>
            </div>

            {% if build.materials|length > 0 %}
            <div class="container">
                <h3 class="title">Matériaux Requis</h3>
                <div class="flex flex-col gap-2">
                    {% for material in build.materials %}
                    <div class="flex justify-between px-4 py-2 rounded w-full bg-(--container-color-secondary)">
                        <p class="text-(--title-color)">{{ material.name }}</p>
                        <p class="text-(--primary-color)">x {{ material.quantity }}</p>
                    </div>
                    {% endfor %}
                </div>
            </div>
            {% endif %}

            {% if build.buildTags|length > 0 %}
            <div class="container">
                <h3 class="title">Tags</h3>
                <div class="flex flex-wrap gap-2">
                    {% for tag in build.buildTags %}
                    <span
                        class="bg-(--container-color-secondary) px-2 py-1 text-(--title-color) rounded text-[0.875rem]">
                        {{ tag.tag.name }}
                    </span>
                    {% endfor %}
                </div>
            </div>
            {% endif %}
        </div>
    </div>
</div>

{% endblock %}
