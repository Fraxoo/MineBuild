{% extends 'base.html.twig' %}

{% block title %}Build
{% endblock %}

{% block body %}
	{# {{ dump(build) }} #}
	<twig:GoBack/>
	<div>
		<div>
			<div class="relative w-full max-w-3xl  overflow-hidden rounded-xl" data-carousel>
				<div class="flex transition-transform duration-300 ease-in-out" data-carousel-track>

					{% for image in build.images %}
						<div class="min-w-full">
							<img src="{{ asset('uploads/build_images/' ~ image.url) }}" alt="{{ build.title }}" class="w-full h-[400px] object-cover">
						</div>
					{% endfor %}
				</div>

				{% if build.images|length > 1 %}
					<button type="button" class="absolute left-3 top-1/2 -translate-y-1/2 bg-black/50 text-white px-3 py-2 rounded-full" data-carousel-prev>
						‹
					</button>

					<button type="button" class="absolute right-3 top-1/2 -translate-y-1/2 bg-black/50 text-white px-3 py-2 rounded-full" data-carousel-next>
						›
					</button>
				{% endif %}
			</div>
			<div></div>
		</div>


		<a href="{{ path('app_build_edit', {'id': build.id}) }}">edit</a>

	{% endblock %}
