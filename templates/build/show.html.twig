{% extends 'base.html.twig' %}

{% block title %}Build
{% endblock %}

{% block body %}
{{ dump(build) }}
<div class="flex flex-col overflow-scroll gap-4">
    <twig:GoBack />
    <div class="flex gap-4 flex-3">
        <div class="flex flex-col gap-4 flex-2">
            <div class="relative w-full h-full  overflow-hidden rounded-xl" data-carousel>
                <div class="flex transition-transform duration-300 ease-in-out" data-carousel-track>

                    {% for image in build.images %}
                    <div class="min-w-full">
                        <img src="{{ asset('uploads/build_images/' ~ image.url) }}" alt="{{ build.title }}"
                            class="w-full h-[600px] object-cover">
                    </div>
                    {% endfor %}
                </div>

                {% if build.images|length > 1 %}
                <button type="button"
                    class="absolute left-3 top-1/2 -translate-y-1/2 bg-black/50 text-white px-3 py-2 rounded-full"
                    data-carousel-prev>
                    <i class="fa-solid fa-angle-left"></i>
                </button>

                <button type="button"
                    class="absolute right-3 top-1/2 -translate-y-1/2 bg-black/50 text-white px-3 py-2 rounded-full"
                    data-carousel-next>
                    <i class="fa-solid fa-angle-right"></i>
                </button>
                {% endif %}
            </div>
            <div>
                <h3 class="text-3xl font-bold uppercase text-(--title-color)">{{ build.title }}</h3>
                <p class="text-(--secondary-color) text-xl">{{ build.description }}</p>
            </div>

            <twig:BuildActions :build="build" :isLikedByUser="isLikedByUser" />

            <div
                class="flex items-center gap-2 justify-center bg-(--primary-color) py-3 px-4 text-center rounded font-semibold">
                <i class="fa-solid fa-download"></i>
                <h3>Télecharger ce build ({{ build.downloadsCount }})</h3>
            </div>

            <div class="container">
                <h3 class="title">Notez ce build</h3>
                <div class="flex gap-2">
                    <i class="fa-solid fa-star text-(--primary-color)"></i>
                    <i class="fa-solid fa-star text-(--primary-color)"></i>
                    <i class="fa-solid fa-star text-(--primary-color)"></i>
                    <i class="fa-solid fa-star text-(--primary-color)"></i>
                    <i class="fa-solid fa-star text-(--primary-color)"></i>
                </div>
            </div>

            {#
            <twig:CommentSection :Build="build" /> #}

        </div>


        <div class="flex flex-col flex-1">
            {#
            <twig:BuildUserAction :build="build" /> #}

            <div class="container">
                <h3 class="title">Détails</h3>
                <div class="build-info-gap">
                    <div class="build-info-gap-title">
                        <i class="fa-solid fa-gamepad"></i>
                        <p>Version</p>
                    </div>
                    <p class="bg-(--container-color-secondary) px-2 py-1 text-(--title-color) rounded text-[0.875rem]">{{ build.gameVersion }} </p>
                </div>
                <div class="build-info-gap">
                    <div class="build-info-gap-title">
                        <i class="fa-solid fa-bolt"></i>
                        <p>Difficulté</p>
                    </div>
                    <p class="{{ build.difficulty === 'easy' ? 'bg-green-100 text-green-200' : build.difficulty === 'medium' ? 'bg-blue-300/20 text-blue-600' : build.difficulty === 'hard' ? 'bg-yellow-100 text-yellow-200' : 'bg-red-100 text-red-200' }} px-2 py-1  rounded text-[0.875rem]">{{ build.difficulty }}</p>
                </div>
                <div class="build-info-gap">
                    <div class="build-info-gap-title">
                        <i class="fa-solid fa-weight-hanging"></i>
                        <p>Taille</p>
                    </div>
                    <p class="bg-(--container-color-secondary) px-2 py-1 text-(--title-color) rounded text-[0.875rem]">L:{{build.dimensionsX}} - H:{{build.dimensionsY}} - P:{{build.dimensionsZ}}</p>
                </div>
                <div class="build-info-gap">
                    <div class="build-info-gap-title">
                        <i class="fa-solid fa-calendar"></i>
                        <p>Publié le </p>
                    </div>
                    <p class=" px-2 py-1 text-(--title-color) rounded text-[0.875rem]">{{ build.createdAt|date('d/m/Y') }}</p>
                </div>
            </div>


        </div>
    </div>


    {# <a href="{{ path('app_build_edit', {'id': build.id}) }}">edit</a> #}
</div>

{% endblock %}