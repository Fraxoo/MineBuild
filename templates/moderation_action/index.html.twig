{% extends 'base.html.twig' %}

{% block title %}ModerationAction index{% endblock %}

{% block body %}
    <h1>ModerationAction index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Target_type</th>
                <th>Action</th>
                <th>Reason</th>
                <th>Created_at</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for moderation_action in moderation_actions %}
            <tr>
                <td>{{ moderation_action.id }}</td>
                <td>{{ moderation_action.targetType.value }}</td>
                <td>{{ moderation_action.action.value }}</td>
                <td>{{ moderation_action.reason }}</td>
                <td>{{ moderation_action.createdAt ? moderation_action.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('app_moderation_action_show', {'id': moderation_action.id}) }}">show</a>
                    <a href="{{ path('app_moderation_action_edit', {'id': moderation_action.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_moderation_action_new') }}">Create new</a>
{% endblock %}
