<section class="flex flex-col gap-4" aria-label="Historique de modération">
    {% for item in items %}
	<article class="flex flex-col gap-4 p-4 bg-(--container-color) rounded">
        <div class="flex items-center text-xs gap-3">
            <div class="flex flex-wrap items-center gap-3">
                <div
                    class="text-(--secondary-color)  px-2 py-1 rounded border border-(--border-color) flex items-center gap-1">
                    <i class="ti text-[1rem] {{ item.targetType.value === "user" ? " ti-user" : (item.targetType.value==="build"
                        ? " ti-blocks" : " ti-message-circle" ) }}"></i>
                    <p>{{ item.targetType.value }}</p>
                </div>
                <p class="text-(--secondary-color)">
                    <span class="text-(--title-color)">{{ item.targetUser.username }}</span>
                </p>
                <div class="flex items-center gap-1 text-red-500 font-bold">
                    <i class="fa-solid text-[1rem] fa-circle-exclamation"></i>
                    <p>
                        {{ item.targetUser.reportsCount }} signalement{{ item.targetUser.reportsCount > 1 ? 's' : '' }}
                    </p>
                </div>

            </div>
        </div>

        {% if item.targetType.value === "comment" %}
		<blockquote class="dashboard-info rounded">{{item.comment.content}}</blockquote>
        {% elseif item.targetType.value === "build" %}
		<p class="dashboard-info">{{item.build.title}}</p>
        {% endif %}

        <div class="flex items-center flex-wrap text-sm gap-4">
            <div class="flex items-center text-red-500 font-semibold">
                <i class="ti ti-flag text-[1rem]"></i>
                {{ ('report.reason.' ~ item.reasonCode.value)|trans }}
            </div>
            <div class="flex items-center text-(--secondary-color)">
                <i class="ti ti-history text-[1rem]"></i>
                <p>{{item.createdAt|date('d/m/Y')}} {{item.createdAt|date('h:m')}}</p>
            </div>
            {% if item.report %}
            <p class="text-(--secondary-color)">Signalement fait par <span class="text-(--title-color)">{{
                    item.report.reporter.username}}</span>
            </p>
            {% endif %}

            <p class="text-(--secondary-color)">Modéré par <span class="text-(--title-color)">{{ item.moderator.username }}</span></p>

        </div>

        <p class="text-(--secondary-color)">{{item.reason}}</p>
	</article>
    {% endfor %}
</section>
