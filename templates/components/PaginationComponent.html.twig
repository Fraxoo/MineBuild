<div {{ attributes }} class="flex flex-col gap-4">
	{% if items %}
		<div class=" flex flex-col md:grid md:grid-cols-4 gap-4" {{ attributes }}>
			{% for item in items %}
				<twig:BuildCard :build="item"/>
			{% endfor %}
		</div>
	{% else %}
		<p class="text-(--title-color) font-semibold p-12 text-center w-full">Aucun résultat</p>

	{% endif %}



	{% if totalPages > 1 %}
		<nav class="flex items-center justify-center gap-2 mt-8">

			{% if currentPage > 1 %}
				<a href="{{ path( app.current_route , app.current_route_parameters|merge(app.request.query.all)|merge({ page: currentPage - 1 })) }}" class="px-3 py-2 bg-(--container-color) border border-(--border-color) rounded">
					<i class="fa-solid fa-angle-left text-white"></i>
				</a>
			{% endif %}

			{% for page in 1..totalPages %}
				<a href="{{ path( app.current_route , app.current_route_parameters|merge(app.request.query.all)|merge({ page: page })) }}" class="px-3 h-fit py-2 border border-(--primary-color-muted) rounded {{ page == currentPage ? 'bg-(--primary-color) text-black' : 'text-white' }}">
					{{ page }}
				</a>
			{% endfor %}

			{% if currentPage < totalPages %}
				<a href="{{ path( app.current_route , app.current_route_parameters|merge(app.request.query.all)|merge({ page: currentPage + 1 })) }}" class="px-3 py-2 bg-(--container-color) border border-(--border-color) rounded">
					<i class="fa-solid fa-angle-right text-white"></i>
				</a>
			{% endif %}

		</nav>
	{% endif %}


</div>
