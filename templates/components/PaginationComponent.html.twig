<div {{ attributes }} class="flex flex-col gap-4">
	{% if items %}
		<div class=" flex flex-col md:grid md:grid-cols-4 gap-4" {{ attributes }}>
			{% if isFollow %}
				{% for item in items %}
					{% set followUser = followType == 'followers' ? item.follower : item.following %}
					<a href="{{ path('app_user_show', {id: followUser.id}) }}" class="flex user-box group items-center gap-4">
						<img class="w-12 h-12 rounded-full object-cover" src="{{ followUser.avatarUrl ? asset('uploads/avatars/' ~ followUser.avatarUrl) : asset('images/default-avatar.jpg') }}" alt="Avatar de {{ followUser.username }}">
						<p class="text-(--title-color) group-hover:underline font-bold">{{ followUser.username }}</p>
					</a>
				{% endfor %}
			{% else %}
				{% for item in items %}
					<twig:BuildCard :build="item"/>
				{% endfor %}
			{% endif %}
		</div>
	{% else %}
		<p class="text-(--title-color) font-semibold p-12 text-center w-full">Aucun résultat</p>

	{% endif %}


	{% if totalPages > 1 %}
		<nav class="flex items-center justify-center gap-2 mt-8">

			{% if currentPage > 1 %}
				<a href="{{ path(app.current_route, app.current_route_parameters|merge(app.request.query.all)|merge({ page: currentPage - 1 })) }}" class="inline-flex items-center justify-center w-10 h-10 shrink-0 bg-(--container-color) border border-(--border-color) rounded">
					<i class="ti ti-chevron-left text-white text-[1rem] leading-none"></i>
				</a>
			{% endif %}

			{% for page in 1..totalPages %}
				<a href="{{ path(app.current_route, app.current_route_parameters|merge(app.request.query.all)|merge({ page: page })) }}" class="inline-flex items-center justify-center w-10 h-10 shrink-0 border border-(--primary-color-muted) rounded leading-none {{ page == currentPage ? 'bg-(--primary-color) text-black' : 'bg-(--container-color) text-white' }}">
					{{ page }}
				</a>
			{% endfor %}

			{% if currentPage < totalPages %}
				<a href="{{ path(app.current_route, app.current_route_parameters|merge(app.request.query.all)|merge({ page: currentPage + 1 })) }}" class="inline-flex items-center justify-center w-10 h-10 shrink-0 bg-(--container-color) border border-(--border-color) rounded">
					<i class="ti ti-chevron-right text-white text-[1rem] leading-none"></i>
				</a>
			{% endif %}

		</nav>
	{% endif %}


</div>
