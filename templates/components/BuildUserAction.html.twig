<div{{ attributes }} class="container">
    <div class="flex gap-2 items-center">
        <img class="w-18 h-18 rounded-full border-4 border-(--border-color-secondary) object-cover"
            data-avatar-preview-target="image"
            src="{{ build.author.avatarUrl ? asset('uploads/avatars/' ~ build.author.avatarUrl) : asset('images/default-avatar.svg') }}"
            alt="Avatar de {{ build.author.username }}">
        <div class="flex flex-col">
            <a href="{{ path('app_user_show', {'id': build.author.id}) }}" class="text-(--title-color) hover:underline font-bold">{{ build.author.username }}</a>
            <p class="text-(--secondary-color)">{{build.author.followerRelations|length}} Followers</p>
        </div>
    </div>
    {% if build.author.bio %}
    <p class="text-(--secondary-color)">{{ build.author.bio }}</p>
    {% endif %}
    <div class="flex items-center gap-2">
        {% if app.user %}
        {% if app.user.id === build.author.id %}
        <a class="primary-button w-full" href="{{ path('app_build_edit', {'id': build.id}) }}"><i class="fa-solid fa-pen-to-square"></i> Modifier</a>
        {% else %}
        {% if isFollowedByUser %}
        <button class="primary-button w-full" data-action="live#action" data-live-action-param="follow"><i
                class="fa-solid fa-user-check"></i>Désaboner</button>
        {% else %}
        <button class="primary-button w-full" data-action="live#action" data-live-action-param="follow"><i
                class="fa-solid fa-user-plus"></i> Suivre</button>
        {% endif %}

        {% endif %}
        {% else %}
        <a href="{{ path('app_login') }}" class="primary-button w-full">
            <i class="fa-solid fa-user-plus"></i> Suivre
        </a>
        {% endif %}

        <a class="container-button w-full   " href="{{ path('app_user_show' , { 'id' : build.author.id })}}">Profile</a>

    </div>
    </div>