<section{{ attributes }} class="flex flex-col gap-4" aria-label="Builds de l’utilisateur">
    {% for build in builds %}
	<article class="flex flex-col gap-4 p-4 bg-(--container-color) rounded">
        <div class="flex items-center justify-between gap-4 text-xs">
            <div class="flex flex-wrap items-center gap-3">
                <div class="text-(--secondary-color) px-2 py-1 rounded border border-(--border-color) flex items-center gap-1">
                    <i class="ti text-[1rem] ti-blocks"></i>
                    <p>build</p>
                </div>
                <p class="text-(--secondary-color)">
                    Posté par <span class="text-(--title-color)">{{ build.author.username }}</span>
                </p>
                <div class="flex items-center gap-1 text-(--secondary-color)">
                    <i class="ti ti-calendar-event text-[1rem]"></i>
                    <p>{{ build.createdAt|date('d/m/Y') }}</p>
                </div>
            </div>
            <a href="{{ path('app_build_show', {'id': build.id}) }}" class="container-color-button text-sm!">
                <i class="ti text-[1rem] ti-eye"></i>
                <p>Voir</p>
            </a>
        </div>

        <a href="{{ path('app_build_show', {'id': build.id}) }}" class="dashboard-info hover:text-(--primary-color)">
            {{ build.title }}
        </a>

        <p class="text-(--secondary-color)">{{ build.description ?: 'Aucune description pour ce build.' }}</p>

        <div class="flex flex-wrap items-center text-sm gap-4">
            <div class="flex items-center text-(--secondary-color)">
                <i class="ti ti-eye text-[1rem]"></i>
                <p>{{ build.viewsCount }} vue{{ build.viewsCount > 1 ? 's' : '' }}</p>
            </div>
            <div class="flex items-center text-(--secondary-color)">
                <i class="ti ti-heart text-[1rem]"></i>
                <p>{{ build.likesCount }} like{{ build.likesCount > 1 ? 's' : '' }}</p>
            </div>
            <div class="flex items-center text-(--secondary-color)">
                <i class="ti ti-download text-[1rem]"></i>
                <p>{{ build.downloadsCount }} téléchargement{{ build.downloadsCount > 1 ? 's' : '' }}</p>
            </div>
        </div>

        <div class="flex items-center gap-4 border-t border-(--border-color) py-2" {{ stimulus_controller('modal-form') }}>
            <button data-action="click->modal-form#openModal"
                class="btn flex gap-4 items-center border-0 text-white bg-red-500 hover:bg-red-600 font-bold rounded-lg text-sm! px-4 py-2"
                type="button">
                <i class="ti text-[1rem] ti-trash"></i>
                <p>Supprimer</p>
            </button>
            <twig:DeleteModal :id="build.id" type="build" />
        </div>
	</article>
    {% else %}
	<p class="bg-(--container-color) p-8 rounded text-center text-(--secondary-color)">
        Aucun build visible pour cet utilisateur.
	</p>
    {% endfor %}
</section>
