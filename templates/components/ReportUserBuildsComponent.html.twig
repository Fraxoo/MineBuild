<div{{ attributes }} class="flex flex-col gap-4">
    {% for build in builds %}
    <div class="flex flex-col gap-4 p-4 bg-(--container-color) rounded">
        <a href="{{ path('app_build_show' , {id : build.id})}}" class="flex gap-4 items-center">
            <img src="{{ asset('uploads/build_images/' ~ build.images[0].url) }}" alt="{{ build.title }}"
                class="w-full rounded flex-1/5 object-contain">
            <div class="flex flex-col flex-4/5">
                <p class="text-(--title-color)">{{ build.title}}</p>
                <p class="text-(--secondary-color)">{{build.description ? build.description : "Aucun description" }}</p>
            </div>
        </a>

        <div class="flex items-center gap-4 border-t border-(--border-color) py-2" {{ stimulus_controller('modal-form')
            }}>
            <button data-action="click->modal-form#openModal"
                class="btn flex gap-4 items-center border-0 text-white bg-red-500 hover:bg-red-600 font-bold rounded-lg text-sm! px-4 py-2"
                type="button">
                <i class="ti text-[1rem] ti-trash"></i>
                <p>Supprimer</p>
            </button>
            <twig:DeleteModal :id="build.id" type="build" />
        </div>
    </div>
    {% else %}
    <div class="bg-(--container-color) p-8 rounded text-center text-(--secondary-color)">
        Aucun build visible pour cet utilisateur.
    </div>
    {% endfor %}
    </div>