<div{{attributes}} class="flex items-center border-b border-(--border-color) justify-between p-4">
	<twig:WebsiteTitle />
	<form class="input-input w-1/3" action="{{ path('app_home', { page: 1 }) }}" method="get">

		<button class="cursor-pointer">
			<i class="fa-solid fa-magnifying-glass"></i>
		</button>
		<input name="search" class="w-full" placeholder="Rechercher des builds, auteur..." type="search">
	</form>
	{# <div class="flex items-center text-(--title-color) text-xl gap-4">
		<i class="ti text-2xl! ti-bell"></i>
