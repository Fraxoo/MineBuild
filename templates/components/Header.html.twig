<div{{attributes}} class="flex items-center border-b border-(--border-color) gap-4 justify-between p-4">
	
	<div class="md:flex hidden">
		<twig:WebsiteTitle />
	</div>
	<i class="ti flex md:hidden text-white text-4xl! ti-menu-2"></i>

	<form class="input-input bg-(--search)!  md:w-1/3" action="{{ path('app_home', { page: 1 }) }}" method="get">

		<button class="cursor-pointer">
			<i class="fa-solid fa-magnifying-glass"></i>
		</button>
		<input name="search" class="w-full outline-none! focus:outline-none! focus:ring-0!" placeholder="Rechercher des builds, auteur..." type="search">
	</form>
	<div class="flex items-center text-(--title-color) text-xl gap-2">
		<i class="ti text-2xl! ti-bell"></i>
		<div class="dropdown bg-(--background-color) ">
			<div tabindex="0" role="button" class=" cursor-pointer border-0 shadow-none bg-(--background-color)! m-1">
				{% if app.user %}
				<img class="w-10 h-10 min-w-10 min-h-10 shrink-0 rounded-full border-4 border-(--border-color-secondary) object-cover"
					data-avatar-preview-target="image"
					src="{{ app.user.avatarUrl ? asset('uploads/avatars/' ~ app.user.avatarUrl) : asset('images/default-avatar.jpg') }}"
					alt="Avatar de {{ app.user.username }}">

				{% else %}
				<i class="text-2xl! ti ti-user"></i>
				{% endif %}
			</div>
			<div class="dropdown-content">
				{% if app.user %}
				<a href="{{ path('app_user_show', { id: app.user.id }) }}"
					class="dropdown-link border-b border-(--border-color)">
					<img class="w-10 h-10 rounded-full border-4 border-(--border-color-secondary) object-cover"
						data-avatar-preview-target="image"
						src="{{ app.user.avatarUrl ? asset('uploads/avatars/' ~ app.user.avatarUrl) : asset('images/default-avatar.jpg') }}"
						alt="Avatar de {{ app.user.username }}">
					<h3>{{app.user.username}}</h3>
				</a>
				<a class="dropdown-link" href="{{ path('app_user_show', { id: app.user.id }) }}">
					<i class="ti ti-user"></i>
					<p>Mon profil</p>
				</a>
				<a class="dropdown-link" href="{{ path('app_user_favorites', { id: app.user.id }) }}">
					<i class="ti ti-heart"></i>
					<p>Mes favoris</p>
				</a>
				<a class="dropdown-link" href="{{ path('app_user_edit', { id: app.user.id }) }}">
					<i class="ti ti-settings"></i>
					<p>Paramétres</p>
				</a>
				<a class="border-t border-(--border-color)  dropdown-link" href="{{ path('app_logout') }}">
					<i class="ti ti-arrow-bar-right"></i>
					<p class="text-red-500!">Déconnexion</p>
				</a>
				{% else %}
				<a class="dropdown-link" href="{{ path('app_login') }}">
					<i class="ti ti-login"></i>
					<p>Se connecter</p>
				</a>
				<a class="dropdown-link" href="{{ path('app_register') }}">
					<i class="ti ti-user-plus"></i>
					<p>S'enregistrer</p>
				</a>
				{% endif %}
			</div>

		</div>
	</div>
	</div>