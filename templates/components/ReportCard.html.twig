<div{{attributes}} class="flex flex-col gap-4 p-4 bg-(--container-color) rounded">
    {# {{ dump(report) }} #}

    <div class="flex flex-wrap items-center text-xs gap-3">
        <div class="flex items-center gap-3">
            <div
                class="text-(--secondary-color)  px-2 py-1 rounded border border-(--border-color) flex items-center gap-1">
                <i class="ti text-[1rem] {{ report.targetType.value === "user" ? " ti-user" : (report.targetType.value==="build"
                    ? " ti-blocks" : " ti-message-circle" ) }}"></i>
                <p>{{ report.targetType.value }}</p>
            </div>
            <a href="{{ path('app_report_users_builds' , { id: report.user.id})}}" class="text-(--title-color) hover:underline">{{ report.user.username }}</a>
            <div class="flex items-center gap-1 text-red-500 font-bold">
                <i class="fa-solid text-[1rem] fa-circle-exclamation"></i>
                <p>{{ report.targetReportsCount }}
                    signalement{{ report.targetReportsCount > 1 ? 's' : '' }}</p>
            </div>
        </div>
    </div>

    {% if report.targetType.value === "comment" %}
    <i class="dashboard-info rounded">{{report.comment.content}}</i>
    {% elseif report.targetType.value === "build" %}
    <i class="dashboard-info">{{report.build.title}}</i>
    {% endif %}

    <div class="flex flex-wrap items-center text-sm gap-4">
        <div class="flex items-center text-red-500 font-semibold">
            <i class="ti ti-flag text-[1rem]"></i>
            {{ ('report.reason.' ~ report.reasonCode.value)|trans }}
        </div>
        <div class="flex items-center text-(--secondary-color)">
            <i class="ti ti-history text-[1rem]"></i>
            <p>{{report.createdAt|date('d/m/Y')}} {{report.createdAt|date('h:m')}}</p>
        </div>
        <p class="text-(--secondary-color)">Signalement fait par <a href="{{ path('app_report_users_builds' , { id: report.reporter.id})}}" class="hover:underline text-(--title-color)">{{
                report.reporter.username}}</a></p>
    </div>

    <p class="text-(--secondary-color)">{{report.message}}</p>

    <div class="flex flex-wrap items-center gap-4 border-t w-full md:w-fit  border-(--border-color) py-2" {{stimulus_controller('modal-form')}}>
        <button data-action="click->modal-form#openModal"
            class="btn  flex gap-2 md:gap-4 flex-1 justify-center items-center border-0 text-white bg-red-500 hover:bg-red-600 font-bold rounded-lg text-sm! px-4 py-2"
            type="button">
            <i class="ti text-[1rem] ti-trash"></i>
            <p>Supprimer</p>
        </button>
        <twig:Modal :report="report" />
        <form method="post" class="flex-1" action="{{ path('app_report_reject', {'id': report.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('reject' ~ report.id) }}">
            <button class="container-color-button w-full! gap-2! md:gap-4! text-sm!">
                <i class="ti text-[1rem] ti-x"></i>
                <p>Rejeter</p>
            </button>
        </form>
    </div>


    </div>
