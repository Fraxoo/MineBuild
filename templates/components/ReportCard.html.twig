<div{{ attributes }} class="flex flex-col gap-4 p-4 bg-(--container-color) rounded">
    {{ dump(report) }}
    <div class="flex items-center text-xs gap-3">
        <div class="text-(--secondary-color)  px-2 py-1 rounded border border-(--border-color) flex items-center gap-1">
            <i class="ti text-sm! {{ report.targetType === " user" ? "ti-user" : (report.targetType==="build" ? "ti-blocks"
                : "ti-message-circle" ) }}"></i>
            <p>{{ report.targetType}}</p>
        </div>
        <p class="text-(--secondary-color)">Par <span class="text-(--title-color)">{{ report.reporter.username }}</span></p>
        <div class="flex items-center gap-1 text-red-500 font-bold">
            <i class="fa-solid fa-circle-exclamation"></i>
            <p>Avertissement</p>
        </div>
    </div>
    </div>