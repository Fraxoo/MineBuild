<div class="modal modal-div fade" tabindex="-1" data-modal-form-target="modal" role="dialog" aria-modal="true" aria-labelledby="report-modal-title-{{ report.id }}">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content p-4 bg-(--container-color) text-(--title-color)">
            <div class="modal-header">
				<h2 id="report-modal-title-{{ report.id }}" class="modal-title">Confirmer la suppression</h2>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"><i class="ti ti-x"></i></button>
            </div>

            <div class="modal-body">
                <p>Êtes-vous sûr de vouloir supprimer ce contenu ?</p>
            </div>

            <div class="modal-footer">
                <form class="flex flex-col gap-4" method="post"
                    action="{{ path('app_report_delete', {'id': report.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ report.id) }}">
                    <div>
						<label for="report-delete-reason-{{ report.id }}" class="text-(--title-color)">Raison :</label>
                        <div class="input-input">
                            <i class="ti ti-pencil"></i>
							<input id="report-delete-reason-{{ report.id }}" minlength="3" maxlength="120" type="text" name="reason" class="input">
                        </div>
                    </div>
                    <div class="flex items-center gap-4">
                        <button
                            class="btn flex gap-4  items-center border-0 text-white bg-red-500 hover:bg-red-600 font-bold rounded-lg text-sm! px-4 py-2"
                            type="submit">
                            <i class="ti text-[1rem] ti-trash"></i>
                            <p>Supprimer</p>
                        </button>
                        <button type="button" class="container-color-button" data-bs-dismiss="modal">
                            Annuler
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
