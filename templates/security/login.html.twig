{% extends 'base.html.twig' %}

{% block title %}Log in!
{% endblock %}

{% block body %}

<div class="middle-container-div">
    <div class="middle-container items-center">
        <div class="flex  flex-col items-center gap-8">
            <twig:WebsiteTitle />
            <div class="flex flex-col items-center gap-4">
                <p class="text-xl text-(--title-color) font-bold">Content de vous revoir</p>
                <p class="text-(--secondary-color)">Connectez-vous pour continuer</p>
            </div>
        </div>
        <form method="post" class="form-div w-full">

            {# {% if app.user %}
            <div class="mb-3">
                You are logged in as
                {{ app.user.userIdentifier }},
                <a href="{{ logout_path() }}">Logout</a>
            </div>
            {% endif %} #}

            <div class="input-div">
                <label class="input-title" for="email">Email</label>
                <div class="input-input {{ error ? 'input-input--error' : '' }}">
                    <i class="fa-regular fa-envelope"></i>
                    <input class="input form-control" placeholder="Email" type="email" value="{{ last_username }}" name="_email" id="email"
                        autocomplete="email" required autofocus>
                </div>
            </div>
            <div class="input-div">
                <label class="input-title" for="password">Mot de passe</label>
                <div class="input-input {{ error ? 'input-input--error' : '' }}">
                    <i class="fa-solid fa-lock"></i>
                    <input type="password" placeholder="Mot de passe" name="_password" id="password" class="input form-control"
                        autocomplete="current-password" required>
                </div>
            </div>
            {% if error %}
            <div class="alert error-message alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}
            <input type="hidden" name="_csrf_token" data-controller="csrf-protection"
                value="{{ csrf_token('authenticate') }}">



            <div class=" mb-3">
                <input type="checkbox" name="_remember_me" id="_remember_me">
                <label class="text-(--title-color)" for="_remember_me">Se souvenir de moi</label>
            </div>


            <button class="btn btn-lg btn-primary primary-button" type="submit">
                Se connecter
            </button>
        </form>

        <p class="text-(--secondary-color) text-center">Vous n'avez pas de compte ?
            <a href="{{ path('app_register') }}" class="text-(--primary-color) hover:underline">S'inscrire</a>
        </p>
    </div>
</div>
{% endblock %}